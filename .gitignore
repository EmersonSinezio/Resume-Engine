# Python compile / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
.streamlit/secrets.toml

# Databases & Vector databases (like Chroma DB)
.memorious/
*.sqlite3
*.db

# Streamlit temporary/static files
.streamlit/static/
.streamlit/run/

# IDEs & System files
.vscode/
.idea/
.project
.pydevproject
.settings/
.DS_Store
Thumbs.db

# Output files
output/*
!output/.gitkeep
*.pdf
temp_cv.html

# Personal Data / Local settings
data/*
!data/.gitkeep
